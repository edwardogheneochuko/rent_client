# Copy to .env (or set in Vercel's dashboard for production).
#
# URL of the backend API, WITHOUT "/api" and without a trailing slash.
# Leave it EMPTY in development: Vite forwards /api to http://localhost:5000.
# In production set it to your Render URL, e.g.
#   VITE_API_URL=https://rentright-api.onrender.com
VITE_API_URL=
